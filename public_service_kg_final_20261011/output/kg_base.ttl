    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_현금 ;
    kg:inField kgc:f_주거_자립 ;
    kg:providedBy kgr:org_통일부 ;
    kg:requires kgc:북한이탈주민 ;
    kg:targetText "○ 북한이탈주민(보호 및 비보호 대상자)" ;
    kg:tier "broad" ;
    dct:identifier "SD0000003310" ;
    dct:title "북한이탈주민 주거지원금 지급"@ko .

kgr:svc_SD0000003311 a kg:Service ;
    kg:ageMin 19 ;
    kg:benefitText """○ 북한이탈주민의 수도권 거주 과밀화 해소, 지방 거주를 장려하기 위해 지방거주장려금 지급

○ 광역시(주거 지원금*10%)

○ 기타 지역(주거 지원금의*20%)
