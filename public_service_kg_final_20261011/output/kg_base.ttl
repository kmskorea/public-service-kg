    kg:requires kgc:기관_단체 ;
    kg:targetText """○ 사회적기업 성장지원센터 입주기업
- 한국사회적기업진흥원 주관 '사회적기업가 육성사업' 창업팀
- 예비사회적기업 및 사회적협동조합 등 사회적경제기업
- 소셜벤처 등 소셜미션이 인정되는 초기 창업기업으로 입주기업으로 선정된 기업""" ;
    kg:tier "broad" ;
    dct:identifier "B55274500004" ;
    dct:title "사회적기업 성장지원센터 입주기업 지원"@ko .

kgr:svc_B55282600002 a kg:Service ;
    kg:applyEndMonth 6 ;
