kgr:svc_B55424400002 a kg:Service ;
    kg:ageMin 18 ;
    kg:applyEnd "2026-07-31"^^xsd:date ;
    kg:applyStart "2026-07-06"^^xsd:date ;
    kg:benefitText """장학생 선발 : 일반대학(원) 및 전문대생 1년에 1회 선발
장학생 선발 인원 : 장애인 20명 내외
- 일반대학(원)생
- 전문대학생
장학금 지급: 학기별 1,000,000원 2회 1년""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "RANGE" ;
    kg:deadlineText "2026. 7. 6.(월) ~ 2026. 7. 31.(금)" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/B55424400002"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_현금_장학금 ;
    kg:inField kgc:f_보육_교육 ;
    kg:providedBy kgr:org_한국장애인개발원 ;
    kg:requires kgc:장애인 ;
    kg:targetText """장학생 종류
(모집 대상) 일반대학(원), 한국방송통신대학, 전문대학, 사이버대학에 재학 중인 장애 학생
1. 성적우수 장학생
- 대학생: 일반대학, 한국방송통신대학, 전문대학, 사이버대학에 재학중인 자로 직전학기 성적이 평균 80점 이상인 자
- 대학원생: 대학원에 재학 중인 자로 직전학기 성적이 평균 89점 이상인 자
2. 예·체능 특기 장학생
최근 3년 이내 국내외 예·체능 대회에서 입상한 경력이 있는 대학(원)생
3. 정보통신 특기 장학생
최근 3년 이내 국내외 정보통신대회에서 입상한 경력이 있는 대학(원)생""" ;
    kg:tier "youth" ;
    dct:identifier "B55424400002" ;
    dct:title "쌍용곰두리장학금 지원"@ko .

