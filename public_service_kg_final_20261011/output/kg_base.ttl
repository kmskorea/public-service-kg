kgr:svc_119200000074 a kg:Service ;
    kg:ageMin 18 ;
    kg:benefitText "○ 천일염장기저장시설 지원(지원조건 : 국비 30%, 지방비 30%, 자담 40%)" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "VARIES" ;
    kg:deadlineText "지자체 사업 공고시" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/119200000074"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인,
        kgc:ut_법인_시설_단체 ;
    kg:hasRequirementGroup kgr:grp_119200000074_법인유형 ;
    kg:hasSupportType kgc:st_현금 ;
