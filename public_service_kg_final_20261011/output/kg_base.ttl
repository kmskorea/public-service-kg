    kg:inField kgc:f_행정_안전 ;
    kg:providedBy kgr:org_행정안전부 ;
    kg:requires kgc:사회복지시설 ;
    kg:targetText "○ 「노인복지법」 제31조에 따른 노인복지시설을 설치ㆍ운영하기 위하여 취득하는 부동산" ;
    kg:tier "broad" ;
    dct:identifier "131200000005" ;
    dct:title "노인복지시설 지방세 감면"@ko .

