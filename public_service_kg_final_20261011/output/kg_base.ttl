kgr:svc_B55370100006 a kg:Service ;
    kg:benefitText """○ 정책서민금융상품 이용자 등 금융취약계층 자영업자에게 전문 컨설턴트의 경영진단과 사업 솔루션을 제공하여 경영 개선을 지원
 - 자영업 업종과 분야별로 맞춤 컨설턴트가 방문 경영진단 후 고객에게 점검 결과와 해결방안 등을 보고서와 함께 제공""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "ALWAYS" ;
    kg:deadlineText "상시신청" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/B55370100006"^^xsd:anyURI ;
