kgr:svc_138300000053 a kg:Service ;
    kg:benefitText "가정폭력 피해자 보호시설 퇴소 시 자립지원금 지급 (피해자 500만원, 동반아동 250만원)" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "ALWAYS" ;
