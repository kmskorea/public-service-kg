    kg:deadlineText "분기별 사전신청" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/140000000177"^^xsd:anyURI ;
    kg:forUserType kgc:ut_법인_시설_단체 ;
