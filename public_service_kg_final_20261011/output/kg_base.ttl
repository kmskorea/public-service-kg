    kg:requires kgc:장애인 ;
    kg:targetText "○ 은평구 거주 중증장애인(심한 장애인)" ;
    kg:tier "broad" ;
    dct:identifier "311000000230" ;
    dct:title "은평구 장애인친화미용실 서비스"@ko .

