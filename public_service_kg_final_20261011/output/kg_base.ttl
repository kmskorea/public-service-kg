kgr:svc_129000000081 a kg:Service ;
    kg:ageMax 37 ;
    kg:ageMin 18 ;
    kg:applyEnd "2026-11-30"^^xsd:date ;
    kg:applyStart "2026-02-02"^^xsd:date ;
    kg:benefitText """군 복무 중 독서 및 학습활동에 소요된 비용의 일부를 지원함
ㅇ 지원대상 : 병 (상근예비역 포함)
ㅇ 지원규모 : 1인당 연간 64,000원, 복무기간 중 최대 128,000원 (2026년 기준)
 - 구매액의 20%는 본인이 부담 (예, 5만 원의 전자책 구독권 구입 시 1만 원은 본인이 부담하고 4만 원을 지원함)
ㅇ 지원 대상
 - 전자책 정기구독권 구입
 - 전자책 구입
 - 종이책 구입(학습도서, 인문교양도서 등)
ㅇ 지원방법
 - 장병e음(https://mosp.mnd.go.kr 또는 "장병e음" 앱)에서 구입과 동시에 지원
 - 장병e음과 연계된 제휴몰에서 온라인으로 구매한 경우 지원""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "RANGE" ;
    kg:deadlineText "2026. 2. 2.~11. 30.(예산 집행상황에 따라 지원 마감일 변경될 수 있음)" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/129000000081"^^xsd:anyURI ;
