    kg:deadlineKind "ALWAYS" ;
    kg:deadlineText "상시신청" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/O00022600027"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
