    kg:inField kgc:f_농림축산어업 ;
    kg:providedBy kgr:org_해양수산부 ;
    kg:requires kgc:어업인 ;
    kg:targetText "○ 귀어업인(희망자 포함) 및 재촌비어업인으로서, 사업신청 연도기준 만 65세 이하인 자" ;
    kg:tier "broad" ;
    dct:identifier "119200000012" ;
    dct:title "귀어 창업 및 주택구입 지원(융자)"@ko .

