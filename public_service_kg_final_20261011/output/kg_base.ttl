    kg:inField kgc:f_행정_안전 ;
    kg:incomeMaxPct 50 ;
    kg:providedBy kgr:org_법무부 ;
    kg:targetText "기초생활수급자, 장애인, 범죄피해자 등 사회적, 경제적 취약계층" ;
