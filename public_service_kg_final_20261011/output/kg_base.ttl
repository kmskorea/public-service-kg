kgr:svc_321000000105 a kg:Service ;
    kg:benefitText "○서초구민 취약계층(기초생활수급자, 심한장애, 국가유공자 등) 대상으로 계절인플루엔자 무료 예방접종" ;
    kg:coversRegion kgr:region_서울_서초구 ;
    kg:deadlineKind "UNKNOWN" ;
    kg:deadlineText "2026년 10월(하반기~)" ;
