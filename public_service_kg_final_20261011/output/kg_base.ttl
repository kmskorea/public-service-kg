kgr:svc_318000000110 a kg:Service ;
    kg:ageMax 64 ;
    kg:ageMin 14 ;
    kg:benefitText """○ 건강 취약계층 독감 무료접종 지원사업
 - 지원내용: 인플루엔자(독감) 무료접종
