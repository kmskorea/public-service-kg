    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/B55201500004"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_기타 ;
