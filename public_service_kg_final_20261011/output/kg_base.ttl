kgr:svc_B49000700017 a kg:Service ;
    kg:ageMax 34 ;
    kg:ageMin 18 ;
    kg:benefitText """○ 지원규모: 3,900명

○ 지원금액: 1인당 최대 500만원 
 - 취업 후 1개월 후 250만원(1차), 6개월 후 100만원(2차), 12개월 후 150만원(3차)""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "VARIES" ;
    kg:deadlineText "접수기관 별 상이" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/B49000700017"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_서비스_일자리 ;
    kg:inField kgc:f_고용_창업 ;
    kg:providedBy kgr:org_고용노동부 ;
    kg:requires kgc:근로자_직장인 ;
    kg:targetText """○ 만 34세 이하 청년으로 해외취업한 자
