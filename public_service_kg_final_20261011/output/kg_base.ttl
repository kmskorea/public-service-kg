kgr:svc_129000000008 a kg:Service ;
    kg:applyEnd "2026-03-31"^^xsd:date ;
    kg:applyStart "2025-04-01"^^xsd:date ;
    kg:benefitText "ㅇ 보상금, 특별위로금, 특별공로금 등" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "RANGE" ;
    kg:deadlineText "2025. 4. 1. ~ 2026. 3. 31." ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/129000000008"^^xsd:anyURI ;
