    kg:providedBy kgr:org_서울특별시_은평구 ;
    kg:targetText "은평구 구민이면 누구나" ;
    kg:tier "broad" ;
    dct:identifier "311000000147" ;
    dct:title "구민 정보화교육"@ko .

kgr:svc_311000000149 a kg:Service ;
    kg:ageMin 18 ;
    kg:benefitText """경력보유여성 혹은 새로운 분야의 일자리를 찾는 여성을 위해 직업 상담, 직업 훈련교육, 취업 연계 등을 지원하는 서울시 지정 은평구 관내 유일한 여성 직업능력 개발 전문기관입니다.
직업능력개발훈련을 통한 자격증 취득, 실습 기회 제공, 취업 연계 및 사후관리 등을 지원합니다.""" ;
    kg:coversRegion kgr:region_서울_은평구 ;
    kg:deadlineKind "ALWAYS" ;
    kg:deadlineText "상시신청" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/311000000149"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
