    kg:deadlineText "상시 신청 가능하나 대여는 주민센터 근무 시간 내에 가능" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/318000000404"^^xsd:anyURI ;
