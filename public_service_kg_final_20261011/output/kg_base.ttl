kgr:svc_154300000002 a kg:Service ;
    kg:applyEndMonth 2 ;
    kg:applyStartMonth 1 ;
    kg:benefitText """○ 준비단계지원 : 86백만 원 = 4개 내외 품목 × 40~60백만원 × 50~60% / 자부담 40~50%
○ 인체적용전시험 : 540백만 원 = 9개 품목 × 120백만원 × 50~60% / 자부담 40~50%
○ 인체적용시험 1년차 : 540백만 원 = 9개 품목 × 120백만원 × 50~60% / 자부담 40~50%
○ 인체적용시험 2년차 : 552백만 원 = 10개 품목 × 120백만원 × 50~60% / 자부담 40~50%
○ 원료 등록지원 : 70백만 원 = 4개 내외 품목 × 30~40백만원(차등지원) × 50~60% / 자부담 40~50%""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "ANNUAL" ;
    kg:deadlineText "매년 1~2월에 사업공고 후 선정" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/154300000002"^^xsd:anyURI ;
    kg:forUserType kgc:ut_법인_시설_단체 ;
    kg:hasRequirementGroup kgr:grp_154300000002_법인유형 ;
