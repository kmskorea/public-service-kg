    kg:providedBy kgr:org_보건복지부 ;
    kg:requires kgc:출산_입양 ;
    kg:targetText """○ 지원 대상
 - 자녀를 출산하거나 입양한 국민연금 가입자""" ;
    kg:tier "broad" ;
    dct:identifier "WII000000260" ;
    dct:title "국민연금출산크레딧"@ko .

kgr:svc_WII000000310 a kg:Service ;
    kg:ageMin 18 ;
    kg:benefitText "○ 노후준비에 필요한 재무,건강,여가,대인관계 등의 분야에 대한 종합적인 노후준비 진단, 상담, 교육, 관계기관 연계, 사후관리 서비스 제공" ;
