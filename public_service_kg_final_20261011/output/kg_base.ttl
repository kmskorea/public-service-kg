@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://kg.example.org/ontology> a owl:Ontology ;
    rdfs:label "대한민국 공공서비스 KG 온톨로지 v0.2"@ko .

kg:ageMax a owl:DatatypeProperty ;
    rdfs:label "최대 연령"@ko ;
    rdfs:range xsd:integer .

kg:ageMin a owl:DatatypeProperty ;
    rdfs:label "최소 연령"@ko ;
    rdfs:range xsd:integer .

kg:anyOf a owl:ObjectProperty ;
    rdfs:label "묶음 안에서 하나 이상"@ko ;
    rdfs:comment "관계 종류: 자격"@ko ;
    rdfs:domain kg:RequirementGroup ;
    rdfs:range kg:TargetGroup .

kg:applyEnd a owl:DatatypeProperty ;
    rdfs:label "신청 종료일"@ko ;
    rdfs:range xsd:date .

kg:applyEndMonth a owl:DatatypeProperty ;
    rdfs:label "매년 신청 종료 월"@ko ;
    rdfs:range xsd:integer .

kg:applyStart a owl:DatatypeProperty ;
    rdfs:label "신청 시작일"@ko ;
    rdfs:range xsd:date .

kg:applyStartMonth a owl:DatatypeProperty ;
    rdfs:label "매년 신청 시작 월"@ko ;
    rdfs:range xsd:integer .

kg:benefitText a owl:DatatypeProperty ;
    rdfs:label "지원내용 원문"@ko ;
    rdfs:range xsd:string .

kg:budgetLimited a owl:DatatypeProperty ;
    rdfs:label "예산 소진·예산 범위 내 신청"@ko ;
    rdfs:range xsd:boolean .

kg:coversRegion a owl:ObjectProperty ;
    rdfs:label "대상 지역"@ko ;
    rdfs:comment "관계 종류: 서술"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:Region ;
    rdfs:subPropertyOf dct:spatial .

kg:deadlineKind a owl:DatatypeProperty ;
    rdfs:label "신청기한 유형"@ko ;
    rdfs:range xsd:string .

kg:deadlineText a owl:DatatypeProperty ;
    rdfs:label "신청기한 원문"@ko ;
    rdfs:range xsd:string .

kg:detailUrl a owl:DatatypeProperty ;
    rdfs:label "정부24 상세 URL"@ko ;
    rdfs:range xsd:anyURI .

kg:excludes a owl:ObjectProperty ;
    rdfs:label "해당하면 제외"@ko ;
    rdfs:comment "관계 종류: 자격"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:TargetGroup .

kg:forUserType a owl:ObjectProperty ;
    rdfs:label "사용자구분"@ko ;
    rdfs:comment "관계 종류: 서술"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range skos:Concept .

kg:gender a owl:DatatypeProperty ;
    rdfs:label "성별 제한"@ko ;
    rdfs:range xsd:string .

kg:hasOrgType a owl:ObjectProperty ;
    rdfs:label "기관유형"@ko ;
    rdfs:comment "관계 종류: 계층"@ko ;
    rdfs:domain kg:Organization ;
    rdfs:range skos:Concept .

kg:hasRequirementGroup a owl:ObjectProperty ;
    rdfs:label "OR 묶음 (그룹끼리 AND)"@ko ;
    rdfs:comment "관계 종류: 자격"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:RequirementGroup ;
    rdfs:subPropertyOf cv:holdsRequirement .

kg:hasSupportType a owl:ObjectProperty ;
    rdfs:label "지원유형"@ko ;
    rdfs:comment "관계 종류: 서술"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf dct:type .

kg:inDimension a owl:ObjectProperty ;
    rdfs:label "대상 범주의 차원"@ko ;
    rdfs:comment "관계 종류: 계층"@ko ;
    rdfs:domain kg:TargetGroup ;
    rdfs:range skos:Concept .

kg:inField a owl:ObjectProperty ;
    rdfs:label "서비스분야"@ko ;
    rdfs:comment "관계 종류: 서술"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf cv:thematicArea .

kg:incomeMaxPct a owl:DatatypeProperty ;
    rdfs:label "기준중위소득 상한 %"@ko ;
    rdfs:range xsd:integer .

kg:incomeMinPct a owl:DatatypeProperty ;
    rdfs:label "기준중위소득 하한 % (초과)"@ko ;
    rdfs:range xsd:integer .

kg:jaCode a owl:DatatypeProperty ;
    rdfs:label "JA 코드"@ko ;
    rdfs:range xsd:string .

kg:locatedIn a owl:ObjectProperty ;
    rdfs:label "기관 소재지"@ko ;
    rdfs:comment "관계 종류: 계층"@ko ;
    rdfs:domain kg:Organization ;
    rdfs:range kg:Region .

kg:partOf a owl:ObjectProperty ;
    rdfs:label "상위 지역"@ko ;
    rdfs:comment "관계 종류: 계층"@ko ;
    rdfs:domain kg:Region ;
    rdfs:range kg:Region ;
    rdfs:subPropertyOf dct:isPartOf .

kg:prefers a owl:ObjectProperty ;
    rdfs:label "우대·우선·가점"@ko ;
    rdfs:comment "관계 종류: 자격"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:TargetGroup .

kg:providedBy a owl:ObjectProperty ;
    rdfs:label "소관기관"@ko ;
    rdfs:comment "관계 종류: 서술"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:Organization ;
    rdfs:subPropertyOf cv:hasCompetentAuthority .

kg:recipientOf a owl:ObjectProperty ;
    rdfs:label "그 서비스의 수혜자 범주"@ko ;
    rdfs:comment "관계 종류: 연결"@ko ;
    rdfs:domain kg:TargetGroup ;
    rdfs:range kg:Service .

kg:requires a owl:ObjectProperty ;
    rdfs:label "반드시 해당 (AND)"@ko ;
    rdfs:comment "관계 종류: 자격"@ko ;
    rdfs:domain kg:Service ;
    rdfs:range kg:TargetGroup .

kg:targetText a owl:DatatypeProperty ;
    rdfs:label "지원대상 원문"@ko ;
    rdfs:range xsd:string .

kg:tier a owl:DatatypeProperty ;
    rdfs:label "broad / youth"@ko ;
    rdfs:range xsd:string .

kgr:svc_105100000001 a kg:Service ;
    kg:ageMax 65 ;
    kg:ageMin 18 ;
    kg:benefitText """○ 전년도 연간 부부합산 총 급여액 등(근로소득, 사업소득 또는 종교인소득의 합계)에 따라
 - 근로장려금은
 ㆍ 단독가구 최대 165만 원
 ㆍ 홑벌이 가구 최대 285만 원
 ㆍ 맞벌이 가구 최대 330만 원 지급
 - 자녀 장려금은
 ㆍ 단독가구 해당 없음
 ㆍ 홑벌이 가구 부양자녀 1명 당 최대 100만 원
 ㆍ 맞벌이 가구 부양자녀 1명 당 최대 100만 원 지급

* 자세한 산정식은 홈택스(www.hometax.go.kr)에서 확인 바랍니다""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "UNKNOWN" ;
    kg:deadlineText "○ 정기신청 : 5.1.~5.31.○ 반기신청 - 상반기분 신청 : 9.1.~9.15. - 하반기분 신청 : 3.1.~3.15." ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/105100000001"^^xsd:anyURI ;
    kg:forUserType kgc:ut_가구 ;
    kg:hasSupportType kgc:st_현금 ;
    kg:inField kgc:f_주거_자립 ;
    kg:providedBy kgr:org_국세청 ;
    kg:targetText "○ 신청요건을 모두 충족하는 근로소득, 사업소득 또는 종교인소득이 있는 가구로써 신청기간 내 신청하는 경우 근로소득, 사업소득 또는 종교인소득에 따라 산정한 근로장려금과 부양자녀수에 따라 산정한 자녀장려금을 지급" ;
    kg:tier "broad" ;
    dct:identifier "105100000001" ;
    dct:title "근로·자녀장려금"@ko .

kgr:svc_116010000001 a kg:Service ;
    kg:ageMax 35 ;
    kg:ageMin 19 ;
    kg:benefitText """○ 주택도시기금 주거안정 월세대출 요건을 충족하는 대상자에 대해 월세자금보증 지원
 - 최대 1,152만원 이내에서 월세금을 2년 환산한 금액의 80%까지 대출금액의 80%를 공사가 보증""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "VARIES" ;
    kg:deadlineText "주택도시기금 주거안정 월세대출 규정에 따름" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/116010000001"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_기타,
        kgc:st_상담_법률지원 ;
    kg:inField kgc:f_주거_자립 ;
    kg:incomeMaxPct 200 ;
    kg:providedBy kgr:org_한국주택금융공사 ;
    kg:requires kgc:무주택세대 ;
    kg:targetText """○ 보증금 1억원 이하 및 월세금 60만원 이하인 월세 계약을 체결한 주택도시 기금 주거안정 월세대출 대상자
[우대형]
- 취업준비생(신청일 현재 만 35세 이하의 무소득자이며 부모 소득이 6천만원 이하인 자)
- 희망키움통장 가입자
- 신청일 기준 최근 1년 이내 수급사실이 인정되는 근로장려금 수급자
- 취업 후 5년 이내인 사회초년생으로 신청일 현재 만 35세 이하이며 부부합산 연소득 4천만원 이하인 자
- 신청일 기준 최근 1년 이내 수급사실이 인정되는 자녀장려금 수급자
- 신청일 현재 주거급여 수급자 확인서가 발급되는 주거급여 수급자

[일반형]
- 부부합산 연소득 5천만원 이하자 중 상기 [우대형]에 해당되지 않는 자""" ;
    kg:tier "youth" ;
    dct:identifier "116010000001" ;
    dct:title "주택금융공사 월세자금보증"@ko .

kgr:svc_119200000001 a kg:Service ;
    kg:ageMin 18 ;
    kg:benefitText """○ 고효율 등(燈)(LED, 무전극등(燈) 등)
○ 노후화된 기관(디젤, 가솔린기관 등)
○ 에너지 절감이 가능한 유류절감장치 
○ 대기오염 방지 및 탄소배출 절감이 가능한 매연저감장치 등""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "VARIES" ;
    kg:deadlineText "연초 모집공고에 따름" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/119200000001"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_현금 ;
    kg:inField kgc:f_농림축산어업 ;
    kg:providedBy kgr:org_해양수산부 ;
    kg:requires kgc:어업인 ;
    kg:targetText "○ 어선의 기관, 고효율 등(燈)(집어등, 작업등) 외 에너지 절감 장비의 대체 또는 설치 희망하는 연근해 허가를 가진 어업인" ;
    kg:tier "broad" ;
    dct:identifier "119200000001" ;
    dct:title "친환경 에너지절감장비 보급"@ko .

kgr:svc_119200000007 a kg:Service ;
    kg:ageMin 19 ;
    kg:benefitText """○ 해양사고관련자가 심판원에 대하여 하는 신청ㆍ청구ㆍ진술 등의 대리 또는 대행

○ 해양사고관련자에 대하여 하는 해양사고와 관련된 기술적 자문""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "UNKNOWN" ;
