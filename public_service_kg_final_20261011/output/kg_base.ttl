        kgc:ut_소상공인 ;
    kg:hasSupportType kgc:st_상담_법률지원,
        kgc:st_서비스_일자리 ;
    kg:inField kgc:f_고용_창업 ;
    kg:providedBy kgr:org_고용노동부 ;
    kg:requires kgc:영업중,
        kgc:중소기업 ;
    kg:targetText "○ 비정규직 고용 사업주 및 인사노무관리자, 비정규직 근로자" ;
    kg:tier "broad" ;
    dct:identifier "149200000047" ;
    dct:title "차별 개선 센터"@ko .

kgr:svc_149200000049 a kg:Service ;
    kg:benefitText """○ 재해예방활동을 인정받은 사업주에게 산재보험료 인하
 - 위험성 평가 인정: 20%(인정 유효기간 3년)
 - 사업주 교육 인정: 10%(인정 유효기간 1년)
 · 매년 계속 지원 사업 해당""" ;
    kg:coversRegion kgr:region_전국 ;
