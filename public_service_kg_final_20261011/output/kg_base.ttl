kgr:svc_171000000005 a kg:Service ;
    kg:ageMax 65 ;
    kg:ageMin 15 ;
    kg:benefitText """○ 보험계약자는 1년 만기의 경우 1만원, 3년 만기의 경우 3만원 보험료 납입하며, 나머지 보험료는 과학기술정보통신부장관이 납입

○ 보장내용
 - 재해를 직접적인 원인으로 사망하였을 때 2,000만원 보장
 - 재해입원급부금 : 재해로 인하여 그 치료를 직접목적으로 4일 이상 입원하였을 때(3일 초과 입원일수 1일당, 120일 한도) 1만원
 - 재해수술급부금 : 재해로 인하여 그 치료를 직접목적으로 수술을 받았을 때(수술 1회당) 1종수술 10만원, 2종수술 20만원, 3종수술 30만원, 4종수술 50만원, 5종수술 100만원
 - 만기급부금 : 보험기간이 끝날때까지 살아 있을 때 : 1년만기 1만원, 3년만기 3만원""" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "VARIES" ;
    kg:deadlineText "자세한 날짜는 우체국에 따라 다를 수 있음" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/171000000005"^^xsd:anyURI ;
    kg:forUserType kgc:ut_개인 ;
    kg:hasSupportType kgc:st_현금_보험 ;
    kg:inField kgc:f_생활안정 ;
    kg:incomeMaxPct 50 ;
    kg:providedBy kgr:org_과학기술정보통신부 ;
    kg:targetText """○ 만15~65세 기초생활수급자, 차상위계층
