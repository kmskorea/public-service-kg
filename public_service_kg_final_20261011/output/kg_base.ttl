    kg:hasSupportType kgc:st_기타 ;
    kg:inField kgc:f_문화_환경 ;
    kg:providedBy kgr:org_서울특별시_중랑구 ;
    kg:targetText "중랑구에 거주하거나, 중랑구에 소재한 직장에 다니는 직장인 또는 중랑구에 소재한 학교에 다니는 학생" ;
    kg:tier "broad" ;
