    kg:deadlineKind "ALWAYS" ;
    kg:deadlineText "상시 신청 가능하나 예산 소진 시 신청 마감" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/B55246800011"^^xsd:anyURI ;
    kg:forUserType kgc:ut_법인_시설_단체 ;
