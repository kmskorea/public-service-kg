    kg:providedBy kgr:org_소상공인시장진흥공단 ;
    kg:requires kgc:중소기업 ;
    kg:targetText "소공인 집적지에 소재하는 소공인 관련 비영리 법인" ;
    kg:tier "broad" ;
    dct:identifier "B55307700002" ;
    dct:title "소공인특화지원센터 설치·운영"@ko .

