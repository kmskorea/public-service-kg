kgr:svc_119200000012 a kg:Service ;
    kg:ageMax 65 ;
    kg:ageMin 18 ;
    kg:benefitText "○ 지원대상자로 선정된 자가 사업(일부완료 또는 완료) 후 담보(신용, 물건)를 제공하고, 금융기관(수협은행)에서 융자를 받으면, 해양수산부에서 이자 차이(기준금리-대출금리 1.5%)를 지원" ;
    kg:coversRegion kgr:region_전국 ;
    kg:deadlineKind "EVENT" ;
    kg:deadlineText "농어촌지역 전입일로부터 만 5년이내 신청 가능" ;
    kg:detailUrl "https://www.gov.kr/portal/rcvfvrSvc/dtlEx/119200000012"^^xsd:anyURI ;
