@prefix kg: <http://kg.example.org/ontology#> .
@prefix kgc: <http://kg.example.org/concept/> .
@prefix kgr: <http://kg.example.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
