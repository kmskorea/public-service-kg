# Q0. (설계서 5.3) 중구 거주 22세 대학생, 무주택, 기준중위소득 30% 가 받을 수 있는 사업
SELECT ?title ?region WHERE {
  ?s a kg:Service ; dct:title ?title ; kg:coversRegion ?r ; kg:forUserType kgc:ut_개인 .
  ?r rdfs:label ?region .
  kgr:region_서울_중구 kg:partOf* ?r .
  FILTER EXISTS { { ?s kg:requires ?any } UNION { ?s kg:hasRequirementGroup ?anyg } }   # 대상이 정해진 사업만 (설계서 5.3 의 77건 정의)
  FILTER NOT EXISTS { ?s kg:ageMin ?a FILTER(?a > 22) }
  FILTER NOT EXISTS { ?s kg:ageMax ?b FILTER(?b < 22) }
  FILTER NOT EXISTS { ?s kg:incomeMaxPct ?m FILTER(?m < 30) }
  FILTER NOT EXISTS { ?s kg:incomeMinPct ?n FILTER(?n >= 30) }   # incomeMinPct 는 "초과"
  FILTER NOT EXISTS {
    ?s kg:requires ?c .
    FILTER NOT EXISTS { ?c ^skos:broader* ?pc . ?pc skos:prefLabel|skos:altLabel ?l .
                        FILTER(STR(?l) IN ("대학생", "대학생/대학원생", "무주택세대")) } }
  FILTER NOT EXISTS {
    ?s kg:hasRequirementGroup ?g .
    FILTER NOT EXISTS { ?g kg:anyOf ?c2 . ?c2 ^skos:broader* ?pc2 . ?pc2 skos:prefLabel|skos:altLabel ?l2 .
                        FILTER(STR(?l2) IN ("대학생", "대학생/대학원생", "무주택세대")) } }
  FILTER NOT EXISTS {
    ?s kg:excludes ?c3 . ?c3 ^skos:broader* ?pc3 . ?pc3 skos:prefLabel|skos:altLabel ?l3 .
    FILTER(STR(?l3) IN ("대학생", "대학생/대학원생", "무주택세대")) }
}
ORDER BY ?title
